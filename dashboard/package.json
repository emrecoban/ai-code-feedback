  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "^0.1.3",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}

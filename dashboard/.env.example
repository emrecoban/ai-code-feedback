# Optional. The dashboard defaults to the same Supabase project and
# publishable key the extension ships with (extension/src/constants.ts).
# Copy to .env.local to point a build at a different project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional. Address of the data documentation site (docs/, VitePress) for the
# "Docs" link in the top bar. `pnpm build` publishes the site under /docs/, which
# is the default, so set this only when the docs are hosted somewhere else.
# `pnpm dev` points the link at the docs dev server (http://localhost:5174/).
# VITE_DOCS_URL=https://docs.example.org/

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "dashboard", "dev", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "dashboard/docs", "run", "docs:dev", "--", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "dashboard-dist",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "dashboard", "preview", "--port", "4173", "--strictPort"],
      "port": 4173
    }
  ]
}
